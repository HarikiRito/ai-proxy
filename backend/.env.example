PORT=8080
DEBUG=true
# make run/migrate create DB_FILE when missing; DATABASE_URL derives from it by default
DB_FILE=data/app.db
# comma-separated, empty disables CORS
CORS_ORIGINS=http://localhost:5173
# WorkOS AuthKit (required; api refuses to start without them)
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# exact `iss` of access tokens, see README
WORKOS_ISSUER=
OWNER_EMAIL=
# true for local http and staging (WorkOS-hosted auth domain is cross-site); false only with a same-site custom auth domain
WORKOS_DEV_MODE=true
# seals provider API keys at rest: base64 of 32 random bytes (openssl rand -base64 32). Losing it makes saved keys unreadable
MASTER_KEY=
